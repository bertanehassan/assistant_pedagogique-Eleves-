+              }
+            });
+            // On ne les ajoute qu'une seule fois pour éviter les duplicatas
+            delete reqBody.rawDocuments;
+          }
+        }
+
+        geminiPayload.contents.push({ role, parts });
+      }
+    }
+    
+    if (systemText) {
