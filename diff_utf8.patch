+      if (onFinish) onFinish(text);
+      return text;
+    }
+
+    let finalResult = "";
+    await handleStreamingResponse(res, (chunk) => {
+      finalResult = chunk;
+      if (onChunk) onChunk(chunk);
+    }, () => {}, signal);
+    if (onFinish) onFinish(finalResult);
+    return finalResult;
+  }
+}
